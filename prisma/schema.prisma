// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id                  String  @id
  currencyName        String? @map("coinName")
  currencyNamePlural  String? @map("coinNamePlural")
  currencyEmoji       String? @map("coinEmoji")
  members GuildUser[]
}

// Global
model User {
  id     String      @id
  guilds GuildUser[]
  items  UserItem[]
}

// Per Guild
model GuildUser {
  userId    String
  guildId   String
  xp        Int    @default(0)
  currency  Int    @default(0) @map("coins")
  rank      Int    @default(1)

  user  User  @relation(fields: [userId], references: [id])
  guild Guild @relation(fields: [guildId], references: [id])

  @@id([userId, guildId])
}

// Blueprint
model ItemTemplate {
  id                String    @id @default(cuid())
  name              String    @unique
  emoji             String?
  description       String?
  isStackable       Boolean   @default(true)
  defaultDurability Int?

  items UserItem[]
}

// Instance
model UserItem {
  id           String   @id @default(cuid())
  userId       String
  templateId   String
  quantity     Int      @default(1)
  durability   Int?
  metadata     Json?

  user         User          @relation(fields: [userId], references: [id])
  template     ItemTemplate  @relation(fields: [templateId], references: [id])

  @@unique([userId, templateId])
}

